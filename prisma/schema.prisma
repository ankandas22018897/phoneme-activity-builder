generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WordList {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  words       Word[]
  activities  ActivityConfiguration[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([name])
}

model Word {
  id         Int      @id @default(autoincrement())
  wordListId Int
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  english    String
  phonemes   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([wordListId])
  @@index([english])
}

model ActivityConfiguration {
  id            Int      @id @default(autoincrement())
  name          String
  activityType  ActivityType
  wordListId    Int
  wordList      WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  difficulty    String   @default("medium")
  maxGuesses    Int      @default(6)
  hintsEnabled  Boolean  @default(true)
  rows          Int?
  cols          Int?
  showAnswers   Boolean  @default(false)
  outputTitle   String?
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityType])
  @@index([wordListId])
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}
